<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.reservoir.coupled-astrid</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/Cellar/python@3.14/3.14.3_1/Frameworks/Python.framework/Versions/3.14/bin/python3.14</string>
		<string>/Users/v/other/astrid/scripts/model_environment.py</string>
